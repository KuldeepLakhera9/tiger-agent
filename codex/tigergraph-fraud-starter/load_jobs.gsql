/*
  Edit the four path variables before running. The prepared files must be on a
  filesystem TigerGraph can read; do not use the local Windows path for Savanna.
*/
USE GRAPH FraudInvestigation;

CREATE LOADING JOB load_fraud_data FOR GRAPH FraudInvestigation {
  DEFINE FILENAME transactions = "/data/prepared/transactions.csv";
  DEFINE FILENAME cards = "/data/prepared/cards.csv";
  DEFINE FILENAME identity = "/data/prepared/identity.csv";
  DEFINE FILENAME regions = "/data/prepared/txn_regions.csv";
  DEFINE FILENAME emails = "/data/prepared/txn_emails.csv";
  DEFINE FILENAME next_txns = "/data/prepared/next_transactions.csv";
  DEFINE FILENAME closed_cases = "/data/prepared/closed_cases.csv";
  DEFINE FILENAME closed_case_txns = "/data/prepared/closed_case_transactions.csv";
  DEFINE FILENAME closed_case_cards = "/data/prepared/closed_case_cards.csv";
  DEFINE FILENAME case_pack = "/data/prepared/case_pack.csv";

  LOAD cards
    TO VERTEX Customer VALUES ($"customer_id", $"customer_first_seen", $"customer_last_seen"),
    TO VERTEX Card VALUES ($"card_id", $"customer_id", $"card_fingerprint", $"card4", $"card6", $"card_first_seen", $"card_last_seen"),
    TO EDGE OWNS VALUES ($"customer_id", $"card_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD transactions
    TO VERTEX Transaction VALUES ($"txn_id", $"customer_id", $"card_id", $"ts", $"TransactionDT", $"TransactionAmt", $"risk_score", $"channel", $"ProductCD", $"addr1", $"addr2", $"P_emaildomain", $"R_emaildomain", $"features_json"),
    TO EDGE MADE VALUES ($"card_id", $"txn_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD identity
    TO VERTEX DeviceProfile VALUES ($"device_id", $"device_profile", $"DeviceInfo", $"id_30", $"id_31", $"id_33", $"DeviceType", $"id_15", $"id_23", $"features_json"),
    TO EDGE FROM_DEVICE VALUES ($"txn_id", $"device_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD regions
    TO VERTEX BillingRegion VALUES ($"region_id", $"country_code"),
    TO EDGE BILLED_IN VALUES ($"txn_id", $"region_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD emails
    TO VERTEX EmailDomain VALUES ($"domain"),
    TO EDGE PURCHASER_EMAIL VALUES ($"txn_id", $"domain")
    WHERE $"role" == "purchaser"
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD emails
    TO VERTEX EmailDomain VALUES ($"domain"),
    TO EDGE RECIPIENT_EMAIL VALUES ($"txn_id", $"domain")
    WHERE $"role" == "recipient"
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD next_txns
    TO EDGE NEXT VALUES ($"from_txn_id", $"to_txn_id", $"gap_seconds")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD closed_cases
    TO VERTEX ClosedCase VALUES ($"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at", $"outcome", $"pattern", $"exposure_usd", $"actions_taken", $"report_filed", $"analyst_notes", $"source_json")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD closed_case_txns
    TO EDGE INVOLVES VALUES ($"case_id", $"txn_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD closed_case_cards
    TO EDGE ON_CARD VALUES ($"case_id", $"card_id")
    WHERE $"role" == "primary"
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD closed_case_cards
    TO EDGE CONNECTED_TO VALUES ($"case_id", $"card_id")
    WHERE $"role" == "connected"
    USING HEADER="true", SEPARATOR=",", QUOTE="double";

  LOAD case_pack
    TO VERTEX FraudCase VALUES ($"case_id", $"customer_id", $"card_id", $"flagged_txn_id", $"opened_at", $"trigger_type", $"trigger_text", $"risk_score", "open", "uncertain", 0.0, "none", 0.0, "", "false", "[]", "[]", $"source_json"),
    TO EDGE INVESTIGATES VALUES ($"case_id", $"flagged_txn_id"),
    TO EDGE CASE_ON_CARD VALUES ($"case_id", $"card_id")
    USING HEADER="true", SEPARATOR=",", QUOTE="double";
}

/* Example:
RUN LOADING JOB load_fraud_data;
*/
