# TigerGraph Cloud / Savanna / Community Edition Configuration
# Fill in your TigerGraph instance details if connecting live.
# If left empty, FRAUDGRAPH seamlessly uses the deterministic benchmark case results.

TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=FraudInvestigation
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_TOKEN=

# Optional MCP and Logging settings
TG_TGCLOUD=true
TG_LOG_TOOL_CALLS=false

# Backend Port (default 8000)
PORT=8000
